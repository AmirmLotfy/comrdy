{
  "name": "comrdy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsx scripts/build-provenance.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/server/worker.ts",
    "video:render": "tsx scripts/render-video.ts",
    "serve": "tsx scripts/serve.ts",
    "qualify:intent": "tsx scripts/qualify-intent.ts",
    "format": "prettier --write src scripts tests video next.config.ts",
    "build:provenance": "tsx scripts/build-provenance.ts",
    "deploy:check": "tsx scripts/vercel-preflight.ts"
  },
  "dependencies": {
    "@onkernel/sdk": "^0.139.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "openai": "^6.0.0",
    "playwright": "^1.56.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@remotion/cli": "^4.0.539",
    "remotion": "^4.0.539"
  },
  "type": "module",
  "overrides": {
    "zod": "$zod"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
