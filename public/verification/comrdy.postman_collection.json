      ]
    },
    {
      "name": "Cross-origin mutations are denied",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "https://untrusted.example.invalid"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/confirm",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
