{
  "info": {
    "name": "COMRDY \u2014 Commerce Ready verification kit",
    "description": "Bounded deterministic checks only. No compile, fresh run, approval, recovery, financial action or real provider call. Run against a COMRDY deployment. No credentials or access code required. Test results qualify this HTTP surface only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Environment is explicit",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json();",
              "pm.test(\"Explicit simulation or Sandbox\",()=>pm.expect(d.mode).to.be.oneOf([\"simulation\",\"sandbox\"]));",
              "pm.test(\"No keys in status\",()=>pm.expect(JSON.stringify(d)).not.to.match(/client_secret|api_key|access_token/i));"
            ]
          }
        }
      ]
    },
    {
      "name": "Execute all twelve deterministic cases",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readiness/run?schema=1.0&mode=suite"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json();",
              "pm.test(\"All cases executed\",()=>{pm.expect(d.summary.definedCases).to.eql(12);pm.expect(d.summary.executedCases).to.eql(12);pm.expect(d.results).to.have.lengthOf(12);});",
              "pm.test(\"All independent expectations match\",()=>pm.expect(d.results.every(r=>r.matchedExpectation)).to.eql(true));",
              "pm.test(\"Missing evidence blocks with REVIEW\",()=>pm.expect(d.results.find(r=>r.id===\"missing-total\").gate.decision).to.eql(\"REVIEW\"));",
              "pm.test(\"Wrong currency blocks\",()=>pm.expect(d.results.find(r=>r.id===\"currency\").gate.decision).to.eql(\"DENY\"));",
              "pm.test(\"Stale revision blocks\",()=>pm.expect(d.results.find(r=>r.id===\"stale-revision\").gate.decision).to.eql(\"DENY\"));",
              "pm.test(\"No financial or provider execution\",()=>{pm.expect(d.boundary.providerCalls).to.eql(0);pm.expect(d.boundary.paymentActions).to.eql(0);pm.expect(d.boundary.merchantOrdersCreated).to.eql(0);pm.expect(d.boundary.providerQualification).to.eql(\"not executed\");});",
              "pm.test(\"Evidence is never cached\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.collectionVariables.set(\"suiteHash\",d.reportHash);"
            ]
          }
        }
      ]
    },
    {
      "name": "Identical inputs reproduce the same report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readiness/run?schema=1.0&mode=suite"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Stable evidence hash\",()=>pm.expect(pm.response.json().reportHash).to.eql(pm.collectionVariables.get(\"suiteHash\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing total cannot become permission",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readiness/run?schema=1.0&mode=compare&totalMinor=14800&size=M&quantity=1&evidence=missing-total"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json();",
              "pm.test(\"Baseline remains allowed\",()=>pm.expect(d.results[0].gate.decision).to.eql(\"ALLOW\"));",
              "pm.test(\"Composed decision is REVIEW\",()=>pm.expect(d.results[1].gate.decision).to.eql(\"REVIEW\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "One cent above budget blocks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readiness/run?schema=1.0&mode=compare&totalMinor=16001&size=M&quantity=1&evidence=complete"
