    {
      "name": "Unknown field is rejected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/readiness/run?schema=1.0&mode=suite&url=https://example.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Bounded input error\",()=>pm.expect(pm.response.json().code).to.eql(\"READINESS_INPUT_INVALID\"));"
            ]
          }
        }
      ]
    },
    {
